# Edge for zero-downtime deploys. Owns the host port and proxies to however
# many `api` containers exist on the compose network (Docker DNS lists them
# all). A container that is still starting refuses connections, so a failed
# connect retries another upstream; once the old one is removed, DNS stops
# returning it. Host header and X-Forwarded-For pass through, which the app's
# host split and rate limiter rely on.
{
	auto_https off
	admin off
}

:4500 {
	reverse_proxy {
		dynamic a {
			name api
			port 4500
			refresh 1s
		}
		lb_retries 3
		lb_try_duration 5s
		fail_duration 10s
		max_fails 1
		transport http {
			dial_timeout 2s
		}
	}
}

:4501 {
	request_body {
		max_size 32MB
	}
	reverse_proxy {
		dynamic a {
			name api
			port 4501
			refresh 1s
		}
		lb_retries 3
		lb_try_duration 5s
		fail_duration 10s
		max_fails 1
		transport http {
			dial_timeout 2s
		}
	}
}
