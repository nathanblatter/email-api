# Edge for zero-downtime deploys. Owns the host port and proxies to however
# many `api` containers exist on the compose network (Docker DNS lists them
# all). A container that is still starting refuses connections, so a failed
# connect retries another upstream; once the old one is removed, DNS stops
# returning it. Host header and X-Forwarded-For pass through, which the app's
# host split and rate limiter rely on.
{
	auto_https off
	# Admin stays on (loopback inside the container) so deploys can `caddy
	# reload` a changed Caddyfile without recreating the edge.
	admin localhost:2019
}

:4500 {
	reverse_proxy {
		dynamic a {
			name api
			port 4500
			refresh 1s
		}
		# A retired container's address lingers in DNS for up to the refresh
		# interval; fail it fast and retry the other upstream so no request
		# is lost across a rollover.
		lb_retries 6
		lb_try_duration 6s
		lb_try_interval 100ms
		fail_duration 5s
		max_fails 1
		transport http {
			dial_timeout 400ms
		}
	}
}

:4501 {
	request_body {
		max_size 32MB
	}
	reverse_proxy {
		dynamic a {
			name api
			port 4501
			refresh 1s
		}
		# A retired container's address lingers in DNS for up to the refresh
		# interval; fail it fast and retry the other upstream so no request
		# is lost across a rollover.
		lb_retries 6
		lb_try_duration 6s
		lb_try_interval 100ms
		fail_duration 5s
		max_fails 1
		transport http {
			dial_timeout 400ms
		}
	}
}
