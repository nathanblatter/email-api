# Copy to ~/deploy/email-api/.env on the Mac Mini. Everything else has a default in docker-compose.yml.
EMAIL_API_KEY=            # openssl rand -hex 32; clients send it as X-API-Key
IMESSAGE_API_KEY=         # ~/.config/imessage-api/config.json → api_key
IMESSAGE_FALLBACK_RECIPIENT=   # phone/Apple ID that gets paged when the relay is down
CLOUDFLARE_TUNNEL_TOKEN=       # Cloudflare One → Networks → Tunnels → email-api (public hostname file.nathanblatter.com → app:4501)
MINIO_ACCESS_KEY=              # ~/docker-services/.env MINIO_ROOT_USER
MINIO_SECRET_KEY=              # ~/docker-services/.env MINIO_ROOT_PASSWORD
EMAIL_INBOUND_SECRET=          # openssl rand -hex 32; shared with the Email Worker (set as its INBOUND_SECRET)
CLOUDFLARE_API_TOKEN=          # deploys worker/ (Workers Scripts:Edit + Email Routing Rules:Edit on nathanblatter.com)
CLOUDFLARE_ACCOUNT_ID=
# SQS bridge: auth-service (Lambda) → MailQueue → this bridge → POST /send. Leave SQS_QUEUE_URL empty to disable.
SQS_QUEUE_URL=                 # the auth-service stack's MailQueue URL
BRIDGE_AWS_ACCESS_KEY_ID=      # scoped IAM user from the auth-service stack: sqs:ReceiveMessage/DeleteMessage on that one queue only
BRIDGE_AWS_SECRET_ACCESS_KEY=
BRIDGE_API_KEY=                # docker compose exec api email-api keygen auth-service
# EMAIL_INBOX_NOTIFY=true      # iMessage on each new non-suspicious email
# EMAIL_DAILY_BUDGET=250
# EMAIL_MAX_MESSAGE_MB=10      # relay cap; bigger mail gets download links
# EMAIL_MAX_UPLOAD_MB=1024     # largest single linked file
# EMAIL_FILES_TTL=720h         # links expire after 30 days
